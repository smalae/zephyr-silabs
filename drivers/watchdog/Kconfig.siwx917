menuconfig WATCHDOG_SILABS_SIWX917
	bool "Silabs SiWx917 Watchdog driver"
	default y
	depends on DT_HAS_SILABS_SIWX917_WATCHDOG_ENABLED
	help
	  Enable the Watchdog driver for the Silabs SiWx917 SoC series.

config WDT_SIWX917_COMMON_INIT_PRIORITY
	int "Common initialization priority"
	depends on WATCHDOG_SILABS_SIWX917
	default 42
